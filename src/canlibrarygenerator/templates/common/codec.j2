uint64_t {{ ir.library_name }}_parse_signal(const uint8_t* data, uint8_t msg_length,
                                         uint16_t start_bit, uint8_t length, bool is_big_endian)
{
    if (!data || length == 0 || length > 64 || msg_length > 64) return 0;
    uint64_t result = 0;
    int bit = start_bit;
    for (int i = 0; i < length; ++i) {
        if (bit < 0 || bit >= (int)msg_length * 8) return 0;
        uint64_t value = (data[bit / 8] >> (bit % 8)) & 1u;
        result |= value << (is_big_endian ? length - 1 - i : i);
        bit = {{ ir.library_name }}_next_bit(bit, is_big_endian);
    }
    return result;
}

void {{ ir.library_name }}_insert_signal(uint8_t* data, uint8_t msg_length, uint64_t raw_value,
                                       int start_bit, int length, bool is_big_endian)
{
    if (!data || length <= 0 || length > 64 || msg_length > 64) return;
    int bit = start_bit;
    /* Validate the entire layout before changing any byte. */
    for (int i = 0; i < length; ++i) {
        if (bit < 0 || bit >= (int)msg_length * 8) return;
        bit = {{ ir.library_name }}_next_bit(bit, is_big_endian);
    }
    bit = start_bit;
    for (int i = 0; i < length; ++i) {
        uint8_t mask = (uint8_t)(1u << (bit % 8));
        int value_bit = is_big_endian ? length - 1 - i : i;
        if ((raw_value >> value_bit) & UINT64_C(1)) data[bit / 8] |= mask;
        else data[bit / 8] &= (uint8_t)~mask;
        bit = {{ ir.library_name }}_next_bit(bit, is_big_endian);
    }
}

